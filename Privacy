<style>
  :root{
    --purple:#462C7D;
    --pink:#D552A3;
    --ink:#0f1e35;
    --muted:#4a6070;
    --border:#e8dff0;
    --surface:#ffffff;
    --bg:#f8f5fc;
    --shadow-soft:0 1px 2px rgba(11,30,53,.04),0 8px 24px -12px rgba(11,30,53,.10);
  }
  *{box-sizing:border-box;margin:0;padding:0}
  html{-webkit-font-smoothing:antialiased;scroll-behavior:smooth}
  body{font-family:'Inter',ui-sans-serif,system-ui,sans-serif;background:var(--surface);color:var(--ink);line-height:1.6}
  a{color:var(--purple);text-decoration:none}
  a:hover{text-decoration:underline}

  /* Nav */
  .nav{display:flex;align-items:center;justify-content:space-between;padding:14px 48px;border-bottom:1px solid var(--border);background:rgba(255,255,255,.95);backdrop-filter:blur(14px);box-shadow:var(--shadow-soft);position:sticky;top:0;z-index:50}
  .logo{display:inline-flex;align-items:center;gap:10px;text-decoration:none}
  .logo-mark{width:36px;height:36px;border-radius:4px;display:inline-flex;align-items:center;justify-content:center;background:var(--purple)}
  .logo-text{font-size:17px;font-weight:500;letter-spacing:-.01em;color:var(--ink)}
  .logo-text .cs{color:var(--muted);margin-left:2px}
  .nav-back{font-size:14px;color:var(--muted);display:inline-flex;align-items:center;gap:6px}
  .nav-back:hover{color:var(--ink);text-decoration:none}

  /* Page */
  .page{max-width:720px;margin:0 auto;padding:72px 24px 96px}
  .page-eyebrow{font-size:12px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--pink);margin-bottom:16px}
  .page-title{font-family:'Instrument Serif',serif;font-style:italic;font-size:clamp(36px,5vw,52px);font-weight:400;line-height:1.1;letter-spacing:-.01em;color:var(--ink)}
  .page-meta{margin-top:16px;font-size:14px;color:var(--muted);padding-bottom:40px;border-bottom:1px solid var(--border)}

  /* Content */
  .prose{margin-top:48px;display:flex;flex-direction:column;gap:40px}
  .prose-section h2{font-size:18px;font-weight:600;color:var(--ink);margin-bottom:12px;padding-bottom:8px;border-bottom:1px solid var(--border)}
  .prose-section p{font-size:15px;color:var(--muted);line-height:1.75;margin-bottom:12px}
  .prose-section p:last-child{margin-bottom:0}
  .prose-section ul{margin-top:8px;margin-bottom:12px;padding-left:20px;display:flex;flex-direction:column;gap:6px}
  .prose-section ul li{font-size:15px;color:var(--muted);line-height:1.65}
  .prose-section a{color:var(--purple)}

  /* Footer */
  footer{border-top:1px solid var(--border);padding:32px 48px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:16px}
  .foot-copy{font-size:12px;color:var(--muted)}
  .foot-link{font-size:12px;color:var(--muted)}
  .foot-link:hover{color:var(--ink)}
</style>
